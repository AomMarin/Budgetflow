# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/budgetflow"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5174

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Daily cron (recurring transactions + budget alerts) — set to true for
# local dev to keep the always-on in-process behavior. In production this
# stays unset; the job runs via a separate GitHub Actions schedule instead.
ENABLE_IN_PROCESS_CRON=true

# Seed data (backend/prisma/seed.ts)
# Password for the private admin@budgetflow.app account, used only the first
# time seed.ts ever creates that row in a given database — leave unset for
# local dev (a fallback applies); set a real strong password before seeding
# any shared/production environment for the first time. Never affects an
# admin that already exists — the seed doesn't touch its password on re-run.
SEED_ADMIN_PASSWORD=
