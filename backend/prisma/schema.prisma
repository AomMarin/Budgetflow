// BudgetFlow Database Schema
// ER Design: Users own Accounts, Budgets, Transactions, Transfers, ImportFiles, ImportRules
// Transactions link to both an Account (balance) and a Budget (bucket spending)
// Transfers move allocated funds between Budgets without touching Account balance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  avatar        String?
  role          Role     @default(USER)
  currency      String   @default("THB")
  timezone      String   @default("Asia/Bangkok")
  alertAt80     Boolean  @default(true)
  alertAt90     Boolean  @default(true)
  alertAt100    Boolean  @default(true)
  isPoolAccount Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts              Account[]
  budgets               Budget[]
  transactions          Transaction[]
  transfers             Transfer[]
  importFiles           ImportFile[]
  importRules           ImportRule[]
  auditLogs             AuditLog[]
  allocations           Allocation[]
  recurringTransactions RecurringTransaction[]
  notifications         Notification[]
  ownedHouseholds       Household[]            @relation("HouseholdOwner")
  householdMembership   HouseholdMember?
  actedTransactions     Transaction[]          @relation("TransactionActor")
  poolOfHousehold       Household?             @relation("HouseholdPoolUser")

  @@map("users")
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  currency  String   @default("THB")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@map("accounts")
}

model Budget {
  id               String   @id @default(cuid())
  userId           String
  name             String
  icon             String   @default("💰")
  color            String   @default("#3B82F6")
  allocatedAmount  Decimal  @default(0) @db.Decimal(15, 2)
  spentAmount      Decimal  @default(0) @db.Decimal(15, 2)
  isArchived       Boolean  @default(false)
  sortOrder        Int      @default(0)
  lastAlertedLevel Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  transfersFrom         Transfer[]             @relation("TransferFrom")
  transfersTo           Transfer[]             @relation("TransferTo")
  importRules           ImportRule[]
  allocations           Allocation[]
  recurringTransactions RecurringTransaction[]
  splits                TransactionSplit[]

  @@map("budgets")
}

// Records each income allocation event (distributing income into buckets)
model Allocation {
  id        String   @id @default(cuid())
  userId    String
  budgetId  String
  amount    Decimal  @db.Decimal(15, 2)
  note      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("allocations")
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  accountId    String
  budgetId     String?
  amount       Decimal         @db.Decimal(15, 2)
  type         TransactionType
  description  String
  date         DateTime
  importFileId String?
  isImported   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account     @relation(fields: [accountId], references: [id])
  budget     Budget?     @relation(fields: [budgetId], references: [id])
  importFile ImportFile? @relation(fields: [importFileId], references: [id])

  actorUserId         String?
  linkedTransactionId String?      @unique
  actor               User?        @relation("TransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  linkedTransaction   Transaction? @relation("TransactionLink", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedBy            Transaction? @relation("TransactionLink")

  splits TransactionSplit[]

  @@index([userId, date])
  @@index([userId, type])
  @@index([budgetId])
  @@index([actorUserId])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Populated ONLY when an EXPENSE "borrows" overflow from a second budget —
// absent for the overwhelming majority of transactions, which stay fully
// attributed to Transaction.budgetId as before. Presence of any row here for
// a transactionId is the single signal that its spend crosses budgets; the
// borrowed budget's own allocatedAmount is never touched, only spentAmount.
model TransactionSplit {
  id            String   @id @default(cuid())
  transactionId String
  budgetId      String
  amount        Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  @@unique([transactionId, budgetId])
  @@index([budgetId])
  @@map("transaction_splits")
}

model Transfer {
  id           String   @id @default(cuid())
  userId       String
  fromBudgetId String
  toBudgetId   String
  amount       Decimal  @db.Decimal(15, 2)
  description  String?
  createdAt    DateTime @default(now())

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBudget Budget @relation("TransferFrom", fields: [fromBudgetId], references: [id])
  toBudget   Budget @relation("TransferTo", fields: [toBudgetId], references: [id])

  @@index([userId])
  @@map("transfers")
}

model ImportFile {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  fileSize     Int
  status       ImportStatus @default(PENDING)
  rowCount     Int          @default(0)
  matchedCount Int          @default(0)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("import_files")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Keyword matching rules for auto-categorizing CSV imports
model ImportRule {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  budgetId  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@map("import_rules")
}

model RecurringTransaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  budgetId    String?
  name        String
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  dayOfMonth  Int
  description String?
  isActive    Boolean         @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])
  budget  Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@map("recurring_transactions")
}

enum NotificationType {
  BUDGET_ALERT
  RECURRING_PROCESSED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

// Read-only family sharing: members can view (not edit) each other's data.
// Each member's own Account/Budget/Transaction ownership (userId) is unchanged.
model Household {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  poolUserId String?  @unique
  createdAt  DateTime @default(now())

  owner    User              @relation("HouseholdOwner", fields: [ownerId], references: [id])
  poolUser User?             @relation("HouseholdPoolUser", fields: [poolUserId], references: [id], onDelete: SetNull)
  members  HouseholdMember[]
  invites  HouseholdInvite[]

  @@map("households")
}

// userId is unique: a user belongs to at most one household at a time
model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String        @unique
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("household_members")
}

// Shareable invite code (no email infra) — owner generates, sends manually, recipient redeems
model HouseholdInvite {
  id           String    @id @default(cuid())
  householdId  String
  code         String    @unique
  createdById  String
  expiresAt    DateTime
  usedByUserId String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, IMPORT
  entity    String // Budget, Transaction, Transfer, etc.
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
