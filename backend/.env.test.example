# Copy to .env.test (gitignored) and adjust if your local Postgres differs.
# Database name MUST contain "_test" — src/test/setup.ts refuses to run
# tests otherwise, so this can never accidentally point at a real database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/budgetflow_test"

PORT=3001
NODE_ENV=test

# Any value works locally — tests never call real JWT-protected endpoints
# over HTTP, but the services import the config at load time.
JWT_ACCESS_SECRET=budgetflow-test-access-secret
JWT_REFRESH_SECRET=budgetflow-test-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5174
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
