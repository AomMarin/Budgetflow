# Base URL for the backend API, including the /api/v1 prefix.
# Leave unset for local dev — falls back to http://localhost:3001/api/v1.
# MUST be set in production (e.g. Vercel) to the deployed backend's URL,
# e.g. https://budgetflow-wpdg.onrender.com/api/v1 — otherwise the app will
# silently try to call localhost from the deployed frontend.
VITE_API_URL=
