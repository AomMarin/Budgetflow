# Base URL for the backend API, including the /api/v1 prefix.
# Leave unset for local dev — falls back to the relative path proxied by
# vite.config.ts to localhost:3001. Set this in production (e.g. Vercel)
# to the deployed backend's URL, e.g. https://budgetflow-api.onrender.com/api/v1
VITE_API_URL=
